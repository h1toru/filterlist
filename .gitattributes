##################################################
# File Attributes Modification
##################################################
# This will be applied on checkin and checkout

# Any unspecified file will have Unix line endings. (fallback)
* text eol=lf

# Files that should not be modified
*.zip binary
*.7z binary
*.rar binary
*.tar binary
*.tar.* binary
*.tgz binary
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary
*.webp binary
*.gif binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.aac binary
*.apk binary
*.abb binary
*.xapk binary
*.apkm binary

# Known Windows files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.reg text eol=crlf
autounattend.xml text eol=crlf

# Magisk Module
META-INF/** text eol=lf
system/** binary
common/** text eol=lf